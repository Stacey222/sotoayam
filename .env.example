SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
# Setup-time only: SOTOAYAM_BOOTSTRAP_ADMIN_PASSWORD may be supplied to `npm run setup`.
# Never store that password in shared/.env; prefer the no-echo prompt or a protected password file.
TELEGRAM_BOT_TOKEN=
INTERNAL_API_KEY=
# Stage A compatibility for existing machine callers. Disable after credential usage is verified.
INTERNAL_API_KEY_FALLBACK_ENABLED=true
ADMIN_API_KEY=
# Stage B: disabled by default. If enabled, ADMIN_API_KEY must contain at least 32 characters.
ADMIN_API_KEY_FALLBACK_ENABLED=false
SESSION_ABSOLUTE_TTL_SECONDS=43200
SESSION_IDLE_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=true
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_GLOBAL_PER_MINUTE=60
RATE_LIMIT_ADMIN_READ_PER_MINUTE=300
RATE_LIMIT_ADMIN_WRITE_PER_MINUTE=60
RATE_LIMIT_ADMIN_EXPENSIVE_PER_MINUTE=10
RATE_LIMIT_INTERNAL_PER_MINUTE=600
RATE_LIMIT_AUTH_FAILURE_PER_MINUTE=30
RATE_LIMIT_SHARED_ORIGIN_FACTOR=10
RATE_LIMIT_MAX_KEYS=10000
RATE_LIMIT_TRUSTED_IPS=
HOST=127.0.0.1
PORT=3000
# Safe preparation values only. Choose each operational flag explicitly before production start.
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_UPDATE_MAX_ATTEMPTS=3
TELEGRAM_PROCESSED_RETENTION_DAYS=7
TELEGRAM_DB_BACKOFF_MS=5000
TELEGRAM_MALFORMED_MAX_BATCHES=3
# Shared notification fan-out gate: at most 3 active sends, starting at least 100 ms apart.
TELEGRAM_FANOUT_CONCURRENCY=3
TELEGRAM_FANOUT_INTERVAL_MS=100
REMINDER_SCHEDULER_ENABLED=false
REMINDER_SCHEDULER_INTERVAL_SECONDS=300
BUSINESS_TIME_ZONE=UTC
CRITICAL_ALERT_EVALUATOR_ENABLED=false
# Optional validated JSON override; defaults are documented in docs/architecture/critical-alert-engine.md
# CRITICAL_ALERT_POLICY_JSON={"overdue":{"warningHours":1,"highHours":24,"criticalHours":72},"blocked":{"warningHours":4,"highHours":24,"criticalHours":72},"scheduler":{"staleMinutes":15,"criticalMinutes":60}}
LOG_LEVEL=info
