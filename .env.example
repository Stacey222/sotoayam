SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Setup-time only: SOTOAYAM_BOOTSTRAP_ADMIN_PASSWORD may be supplied to `npm run setup`.
# Never store that password in shared/.env; prefer the no-echo prompt or a protected password file.
TELEGRAM_BOT_TOKEN=
INTERNAL_API_KEY=
ADMIN_API_KEY=
HOST=127.0.0.1
PORT=3000
# Safe preparation values only. Choose each operational flag explicitly before production start.
TELEGRAM_POLLING_ENABLED=false
REMINDER_SCHEDULER_ENABLED=false
REMINDER_SCHEDULER_INTERVAL_SECONDS=300
BUSINESS_TIME_ZONE=UTC
CRITICAL_ALERT_EVALUATOR_ENABLED=false
# Optional validated JSON override; defaults are documented in docs/architecture/critical-alert-engine.md
# CRITICAL_ALERT_POLICY_JSON={"overdue":{"warningHours":1,"highHours":24,"criticalHours":72},"blocked":{"warningHours":4,"highHours":24,"criticalHours":72},"scheduler":{"staleMinutes":15,"criticalMinutes":60}}
LOG_LEVEL=info
