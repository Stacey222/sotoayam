{
  "name": "sotoayam",
  "version": "0.1.0",
  "private": true,
  "description": "Sotoayam automation platform and Telegram notifications",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "setup": "node dist/src/cli/setup.js",
    "setup:dev": "tsx src/cli/setup.ts",
    "admin:reset-password": "node dist/src/cli/admin-reset-password.js",
    "admin:reset-password:dev": "tsx src/cli/admin-reset-password.ts",
    "check:supabase": "tsx scripts/check-supabase.ts",
    "check:schema": "tsx scripts/check-schema.ts",
    "check:governance-schema": "tsx scripts/check-governance-foundation.ts",
    "check:identity-schema": "tsx scripts/check-identity-schema.ts",
    "check:user-management": "tsx scripts/check-user-management.ts",
    "check:task-schema": "tsx scripts/check-task-schema.ts",
    "check:collaboration-schema": "tsx scripts/check-collaboration-schema.ts",
    "check:ingestion-schema": "tsx scripts/check-ingestion-schema.ts",
    "check:notification-schema": "tsx scripts/check-notification-schema.ts",
    "check:reporting-schema": "tsx scripts/check-reporting-schema.ts",
    "check:critical-alert-schema": "tsx scripts/check-critical-alert-schema.ts",
    "check:go-live-stage2-schema": "tsx scripts/check-go-live-stage2-schema.ts",
    "check:first-admin-bootstrap": "tsx scripts/check-first-admin-bootstrap.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:reconciliation": "tsx scripts/reconcile-legacy.ts",
    "check:migration-baseline": "tsx scripts/check-migration-baseline.ts",
    "migrate": "node dist/scripts/migrate.js",
    "migrate:dev": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:contract": "vitest run tests/contracts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "24.20.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "@supabase/supabase-js": "^2.57.4",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "supabase": "2.116.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
